# ---------------------------------------------------------------
# Pratuca — variáveis de ambiente do FRONTEND (Vite)
# Copie para `.env.local` e preencha. Nunca coloque segredos aqui:
# tudo que começa com VITE_ é embutido no JavaScript público.
# ---------------------------------------------------------------

# URL do projeto Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave PÚBLICA do Supabase (publishable key "sb_publishable_..." ou a anon key legada).
# NUNCA use a service_role / secret key no frontend.
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL pública do site (usada em links compartilháveis, Open Graph e redirecionamentos de e-mail)
VITE_SITE_URL=http://localhost:5173

# Canais de suporte exibidos em /ajuda (opcionais)
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_WHATSAPP=

# Provedor de cobrança. Deixe vazio enquanto o gateway não estiver integrado
# (a área de assinatura mostrará "pagamento online pendente de configuração").
VITE_BILLING_PROVIDER=

# ---------------------------------------------------------------
# Segredos de SERVIDOR (Supabase Edge Functions) — NÃO vão para o .env do Vite.
# Configure com: supabase secrets set NOME=valor
#   BILLING_PROVIDER=
#   BILLING_WEBHOOK_SECRET=
#   BILLING_API_KEY=
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são injetadas automaticamente nas Edge Functions.
# ---------------------------------------------------------------
